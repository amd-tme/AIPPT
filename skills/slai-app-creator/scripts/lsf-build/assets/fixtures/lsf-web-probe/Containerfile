FROM docker.io/library/golang@sha256:e87b2a5f6df2dff71ea330d55d54f4979eb380ae58a7e3aabc9d53121243e689 AS build
WORKDIR /src
ENV GOCACHE=/tmp/go-build GOMODCACHE=/tmp/go-mod
COPY go.mod main.go ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags='-s -w' -o /src/server .
FROM scratch
COPY --from=build /src/server /server
EXPOSE 8080
ENTRYPOINT ["/server"]
