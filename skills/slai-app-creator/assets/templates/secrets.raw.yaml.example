# PLAINTEXT TEMPLATE — copy to secrets.raw.yaml, keep it gitignored, then encrypt
# the complete file to secrets.enc.yaml with SOPS.
# Never commit this file after inserting real values.
apiVersion: v1
kind: Secret
metadata:
  name: YOUR_APP_NAME-secrets
  namespace: slai-app-prod
type: Opaque
stringData:
  EXAMPLE_SECRET: REPLACE_ME
  # Database URLs and DB_HOST values must use a pod-resolvable FQDN, not a
  # single-label host. Example:
  # DATABASE_URL: postgresql://user:password@my-postgres.amd.com:5432/app
  # For a Kubernetes Service, use service.namespace.svc.cluster.local.
