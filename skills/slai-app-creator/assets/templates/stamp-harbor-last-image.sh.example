#!/usr/bin/env bash
# TEMPLATE — copy to scripts/stamp-harbor-last-image.sh, then chmod +x.
# Canonical: skills/slai-app-creator/assets/templates/stamp-harbor-last-image.sh.example
#
# When you already know the Harbor image tag (e.g. from authorize-existing-image, CI, or a build you did not
# run locally with publish-image-harbor.sh), write the same .cache/harbor-last-image.env that
# publish-image-harbor.sh writes — without running a local build.
# A verified image-build-lsf result normally uses publish-image-harbor.sh with
# IMAGE_BUILD_LSF_JOB_DIR instead, because that path loads and pushes the exact archive.
#
# Requires .env (or environment) with HARBOR_*, IMAGE_NAME, same as dot-env.harbor.example.
# IMAGE_TAG is the authorized slai-sc release tag. IMAGE_DIGEST is the verified
# Harbor manifest digest from publication or release authorization.
#
# Usage:
#   set -a && source .env && set +a
#   IMAGE_TAG=slai-sc-<sha>-<run>-<attempt> IMAGE_DIGEST=sha256:<verified-digest> \
#     ./scripts/stamp-harbor-last-image.sh
#
# Optional: HARBOR_LAST_IMAGE_FILE (default $ROOT/.cache/harbor-last-image.env), SKIP_DOTENV=1
#
# SPDX: Copyright (c) Advanced Micro Devices, Inc., or its affiliates. All rights reserved.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$ROOT"

if [[ -z "${SKIP_DOTENV:-}" && -f "$ROOT/.env" ]]; then
  set -a
  # shellcheck source=/dev/null
  source "$ROOT/.env"
  set +a
fi

: "${HARBOR_REGISTRY:?Set HARBOR_REGISTRY or add to .env}"
: "${HARBOR_PROJECT:?Set HARBOR_PROJECT (e.g. hw-slaiapp-dev) or add to .env}"
: "${IMAGE_NAME:?Set IMAGE_NAME (Harbor repository name) or add to .env}"
: "${IMAGE_TAG:?Set IMAGE_TAG to the authorized release tag}"
: "${IMAGE_DIGEST:?Set IMAGE_DIGEST to the verified Harbor SHA-256 manifest digest}"
if [[ ! "$IMAGE_DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]]; then
  echo "IMAGE_DIGEST must be sha256:<64 lowercase hex>." >&2
  exit 1
fi

if [[ ! "$HARBOR_REGISTRY" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]{1,5})?$ ]] ||
   [[ ! "$HARBOR_PROJECT" =~ ^[a-z0-9][a-z0-9._-]*$ ]] ||
   [[ ! "$IMAGE_NAME" =~ ^[a-z0-9][a-z0-9._-]*$ ]] ||
   [[ ! "$IMAGE_TAG" =~ ^slai-sc-[0-9a-f]{40}-[1-9][0-9]*-[1-9][0-9]*$ ]]; then
  echo "Use valid Harbor coordinates and an authorized slai-sc release tag." >&2
  exit 1
fi
FULL_IMAGE="${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${IMAGE_NAME}@${IMAGE_DIGEST}"
f="${HARBOR_LAST_IMAGE_FILE:-$ROOT/.cache/harbor-last-image.env}"
mkdir -p "$(dirname "$f")"
umask 077
{
  echo "# Generated by stamp-harbor-last-image.sh (no local build). Use FULL_IMAGE in deployment.yaml."
  echo "FULL_IMAGE=$FULL_IMAGE"
  echo "IMAGE_TAG=$IMAGE_TAG"
  echo "IMAGE_DIGEST=$IMAGE_DIGEST"
} > "$f"
echo "Recorded $f (FULL_IMAGE=$FULL_IMAGE)"
