# DEVELOPER-OWNED ALTERNATE HARBOR PLAINTEXT TEMPLATE — no platform approval required.
# Normal mkmhub.amd.com/hw-slaiapp-dev onboarding does not use this file.
#
# For a private alternate Harbor, append this as a second YAML document
# (with a `---` separator) to the gitignored secrets.raw.yaml, then SOPS-encrypt the
# complete stream to secrets.enc.yaml. Never commit this plaintext file.
#
# metadata.name must match deployment.yaml imagePullSecrets[].name. The auths key
# must exactly match the hostname (and optional port) at the start of containers[].image.
# This Secret is consumed by kubelet only: never reference it through env, envFrom,
# secretKeyRef, volumes, or volumeMounts.
#
# The web-app developer owns the pull identity, rotation, reachability, and maintenance.
# The auth value is base64(username:robot-secret), which is encoding, not encryption.
# Generate it locally without printing it to logs, then SOPS-encrypt the complete stream.
apiVersion: v1
kind: Secret
metadata:
  name: YOUR_APP_NAME-harbor-pull
  namespace: slai-app-prod
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: |
    {"auths":{"YOUR_APPROVED_HARBOR_HOSTNAME":{"auth":"YOUR_BASE64_ENCODED_PULL_ROBOT_USERNAME_COLON_SECRET"}}}
